rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerEmail() {
      return isVerifiedUser() && request.auth.token.email == 'eyadbisness@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isOwnerEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'username', 'displayName', 'role', 'status',
          'membership', 'boardTheme', 'pieceStyle', 'ratings',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'username', 'displayName', 'avatarUrl', 'country', 'bio',
          'role', 'status', 'membership', 'boardTheme', 'pieceStyle',
          'soundEnabled', 'soundVolume', 'showCoordinates', 'autoQueen', 'lowTimeWarningColor', 'language', 'ratings', 'rd',
          'volatility', 'puzzleStreak', 'bestPuzzleStreak', 'dailyStreak',
          'bestDailyStreak', 'lastDailyPuzzleDate', 'dailyPuzzlesCompleted',
          'puzzlesSolved', 'playStreakDays', 'bestPlayStreakDays', 'lastPlayDate',
          'gamesPlayed', 'wins', 'losses', 'draws', 'achievements',
          'isTestAccount', 'onlineStatus', 'lastSeenAt', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512)) &&
        (!('country' in data) || (data.country is string && data.country.size() >= 2 && data.country.size() <= 3)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        data.role in ['user', 'moderator', 'owner'] &&
        data.status in ['active', 'suspended', 'banned'] &&
        data.membership in ['free', 'plus', 'diamond'] &&
        data.boardTheme is string && data.boardTheme.size() >= 1 && data.boardTheme.size() <= 40 &&
        data.pieceStyle in ['neo', 'classic', 'minimal', 'imperial'] &&
        (!('soundEnabled' in data) || data.soundEnabled is bool) &&
        (!('soundVolume' in data) || (data.soundVolume is number && data.soundVolume >= 0 && data.soundVolume <= 100)) &&
        (!('showCoordinates' in data) || data.showCoordinates is bool) &&
        (!('autoQueen' in data) || data.autoQueen is bool) &&
        (!('lowTimeWarningColor' in data) || (data.lowTimeWarningColor is string && data.lowTimeWarningColor.size() == 7 && data.lowTimeWarningColor.matches('^#[0-9a-fA-F]{6}$'))) &&
        (!('language' in data) || data.language in ['en', 'es', 'fr', 'ar']) &&
        data.ratings is map &&
        (!('rd' in data) || data.rd is map) &&
        (!('volatility' in data) || data.volatility is map) &&
        (!('puzzleStreak' in data) || (data.puzzleStreak is number && data.puzzleStreak >= 0)) &&
        (!('bestPuzzleStreak' in data) || (data.bestPuzzleStreak is number && data.bestPuzzleStreak >= 0)) &&
        (!('dailyStreak' in data) || (data.dailyStreak is number && data.dailyStreak >= 0 && data.dailyStreak <= 100000)) &&
        (!('bestDailyStreak' in data) || (data.bestDailyStreak is number && data.bestDailyStreak >= 0 && data.bestDailyStreak <= 100000)) &&
        (!('lastDailyPuzzleDate' in data) || (data.lastDailyPuzzleDate is string && data.lastDailyPuzzleDate.size() <= 10 && data.lastDailyPuzzleDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$'))) &&
        (!('dailyPuzzlesCompleted' in data) || (data.dailyPuzzlesCompleted is number && data.dailyPuzzlesCompleted >= 0 && data.dailyPuzzlesCompleted <= 100000)) &&
        (!('puzzlesSolved' in data) || (data.puzzlesSolved is number && data.puzzlesSolved >= 0 && data.puzzlesSolved <= 100000)) &&
        (!('playStreakDays' in data) || (data.playStreakDays is number && data.playStreakDays >= 0 && data.playStreakDays <= 100000)) &&
        (!('bestPlayStreakDays' in data) || (data.bestPlayStreakDays is number && data.bestPlayStreakDays >= 0 && data.bestPlayStreakDays <= 100000)) &&
        (!('lastPlayDate' in data) || (data.lastPlayDate is string && data.lastPlayDate.size() <= 10 && data.lastPlayDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$'))) &&
        (!('gamesPlayed' in data) || (data.gamesPlayed is number && data.gamesPlayed >= 0)) &&
        (!('wins' in data) || (data.wins is number && data.wins >= 0)) &&
        (!('losses' in data) || (data.losses is number && data.losses >= 0)) &&
        (!('draws' in data) || (data.draws is number && data.draws >= 0)) &&
        (!('achievements' in data) || (data.achievements is list && data.achievements.size() <= 60 && (data.achievements.size() == 0 || data.achievements[0] is string))) &&
        (!('isTestAccount' in data) || data.isTestAccount is bool) &&
        (!('onlineStatus' in data) || data.onlineStatus in ['online', 'playing', 'offline']);
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 254;
    }

    function isValidChessGame(data) {
      return data.keys().hasAll([
          'whiteId', 'blackId', 'whiteName', 'blackName',
          'timeControl', 'category', 'result', 'termination',
          'pgn', 'finalFen', 'rated', 'createdAt', 'endedAt'
        ]) &&
        data.keys().hasOnly([
          'whiteId', 'blackId', 'whiteName', 'blackName',
          'whiteRating', 'blackRating', 'whiteRatingDelta', 'blackRatingDelta',
          'timeControl', 'category', 'result', 'termination', 'winnerId',
          'pgn', 'finalFen', 'openingName', 'eco', 'moveCount',
          'rated', 'isTestGame', 'reviewSummary', 'createdAt', 'endedAt'
        ]) &&
        data.whiteId is string && data.whiteId.size() >= 1 && data.whiteId.size() <= 128 &&
        data.blackId is string && data.blackId.size() >= 1 && data.blackId.size() <= 128 &&
        data.whiteName is string && data.whiteName.size() >= 1 && data.whiteName.size() <= 64 &&
        data.blackName is string && data.blackName.size() >= 1 && data.blackName.size() <= 64 &&
        (!('whiteRating' in data) || data.whiteRating is number) &&
        (!('blackRating' in data) || data.blackRating is number) &&
        (!('whiteRatingDelta' in data) || data.whiteRatingDelta is number) &&
        (!('blackRatingDelta' in data) || data.blackRatingDelta is number) &&
        data.timeControl is string && data.timeControl.size() >= 1 && data.timeControl.size() <= 24 &&
        data.category in ['bullet', 'blitz', 'rapid', 'classical', 'bot', 'sandbox'] &&
        data.result in ['1-0', '0-1', '1/2-1/2'] &&
        data.termination is string && data.termination.size() >= 1 && data.termination.size() <= 40 &&
        (!('winnerId' in data) || (data.winnerId is string && data.winnerId.size() <= 128)) &&
        data.pgn is string && data.pgn.size() <= 30000 &&
        data.finalFen is string && data.finalFen.size() <= 150 &&
        (!('openingName' in data) || (data.openingName is string && data.openingName.size() <= 120)) &&
        (!('eco' in data) || (data.eco is string && data.eco.size() <= 12)) &&
        (!('moveCount' in data) || (data.moveCount is number && data.moveCount >= 0)) &&
        data.rated is bool &&
        (!('isTestGame' in data) || data.isTestGame is bool) &&
        (!('reviewSummary' in data) || data.reviewSummary is map);
    }

    function isValidFriendship(data) {
      return data.keys().hasAll(['requesterId', 'recipientId', 'users', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['requesterId', 'recipientId', 'requesterName', 'recipientName', 'users', 'status', 'createdAt', 'updatedAt']) &&
        data.requesterId is string && data.requesterId.size() >= 1 && data.requesterId.size() <= 128 &&
        data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
        (!('requesterName' in data) || (data.requesterName is string && data.requesterName.size() <= 64)) &&
        (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 64)) &&
        data.users is list && data.users.size() == 2 &&
        data.users[0] is string && data.users[1] is string &&
        data.requesterId in data.users && data.recipientId in data.users &&
        data.status in ['pending', 'accepted', 'blocked'];
    }

    function isValidChallenge(data) {
      return data.keys().hasAll(['challengerId', 'challengerName', 'targetId', 'targetName', 'timeControl', 'category', 'rated', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['challengerId', 'challengerName', 'challengerRating', 'targetId', 'targetName', 'timeControl', 'category', 'colorPreference', 'rated', 'status', 'gameId', 'createdAt', 'updatedAt']) &&
        data.challengerId is string && data.challengerId.size() >= 1 && data.challengerId.size() <= 128 &&
        data.challengerName is string && data.challengerName.size() >= 1 && data.challengerName.size() <= 64 &&
        (!('challengerRating' in data) || data.challengerRating is number) &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 64 &&
        data.timeControl is string && data.timeControl.size() >= 1 && data.timeControl.size() <= 24 &&
        data.category in ['bullet', 'blitz', 'rapid', 'classical'] &&
        (!('colorPreference' in data) || data.colorPreference in ['white', 'black', 'random']) &&
        data.rated is bool &&
        data.status in ['pending', 'accepted', 'declined', 'cancelled', 'expired'] &&
        (!('gameId' in data) || (data.gameId is string && data.gameId.size() <= 128));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'message', 'read', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'type', 'title', 'message', 'read', 'actionRoute', 'createdAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.type in ['friend_request', 'challenge', 'game_result', 'announcement', 'system'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
        data.read is bool &&
        (!('actionRoute' in data) || (data.actionRoute is string && data.actionRoute.size() <= 64));
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'reportedUserId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['reporterId', 'reportedUserId', 'gameId', 'reason', 'details', 'status', 'resolutionNote', 'createdAt', 'updatedAt']) &&
        data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
        data.reportedUserId is string && data.reportedUserId.size() >= 1 && data.reportedUserId.size() <= 128 &&
        (!('gameId' in data) || (data.gameId is string && data.gameId.size() <= 128)) &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 80 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 500)) &&
        data.status in ['open', 'resolved', 'dismissed'] &&
        (!('resolutionNote' in data) || (data.resolutionNote is string && data.resolutionNote.size() <= 300));
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['maintenanceMode', 'features', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['maintenanceMode', 'maintenanceMessage', 'announcement', 'features', 'activeTimeControls', 'updatedAt', 'updatedBy']) &&
        data.maintenanceMode is bool &&
        (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300)) &&
        (!('announcement' in data) || (data.announcement is string && data.announcement.size() <= 300)) &&
        data.features is map &&
        (!('activeTimeControls' in data) || (data.activeTimeControls is list && data.activeTimeControls.size() <= 20 && (data.activeTimeControls.size() == 0 || data.activeTimeControls[0] is string))) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function isValidCustomPuzzle(data) {
      return data.keys().hasAll(['title', 'fen', 'moves', 'rating', 'theme', 'published', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['title', 'fen', 'moves', 'rating', 'theme', 'published', 'createdBy', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.fen is string && data.fen.size() >= 10 && data.fen.size() <= 150 &&
        data.moves is list && data.moves.size() >= 1 && data.moves.size() <= 20 && data.moves[0] is string &&
        data.rating is number && data.rating >= 400 && data.rating <= 3500 &&
        data.theme is string && data.theme.size() >= 1 && data.theme.size() <= 50 &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidCustomLesson(data) {
      return data.keys().hasAll(['title', 'category', 'summary', 'fen', 'solutionMoves', 'published', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['title', 'category', 'summary', 'fen', 'solutionMoves', 'published', 'createdBy', 'createdAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.category in ['opening', 'middlegame', 'endgame', 'checkmate'] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
        data.fen is string && data.fen.size() >= 10 && data.fen.size() <= 150 &&
        data.solutionMoves is list && data.solutionMoves.size() >= 1 && data.solutionMoves.size() <= 20 && data.solutionMoves[0] is string &&
        data.published is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidTournament(data) {
      return data.keys().hasAll(['name', 'timeControl', 'format', 'status', 'published', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['name', 'timeControl', 'format', 'status', 'published', 'maxPlayers', 'registeredCount', 'createdBy', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.timeControl is string && data.timeControl.size() >= 1 && data.timeControl.size() <= 24 &&
        data.format in ['swiss', 'arena', 'knockout'] &&
        data.status in ['upcoming', 'active', 'completed'] &&
        data.published is bool &&
        (!('maxPlayers' in data) || data.maxPlayers is number) &&
        (!('registeredCount' in data) || data.registeredCount is number) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidOwnerAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'details', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetId', 'details', 'createdAt']) &&
        data.actorUid is string && data.actorUid == request.auth.uid && data.actorUid.size() <= 128 &&
        data.actorEmail is string && data.actorEmail.size() <= 254 &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
        (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
        data.details is string && data.details.size() <= 500;
    }

    function isValidOwnerTestAccount(data) {
      return data.keys().hasAll(['displayName', 'username', 'ratings', 'membership', 'isTestAccount', 'createdAt']) &&
        data.keys().hasOnly(['displayName', 'username', 'ratings', 'membership', 'isTestAccount', 'createdAt']) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
        data.ratings is map &&
        data.membership in ['free', 'plus', 'diamond'] &&
        data.isTestAccount == true;
    }

    function isValidSharedGame(data) {
      return data.keys().hasAll([
          'shareId', 'creatorUid', 'creatorName', 'whiteName', 'blackName',
          'pgn', 'hasReviewReport', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'shareId', 'creatorUid', 'creatorName', 'whiteName', 'blackName',
          'result', 'timeControl', 'openingName', 'eco', 'pgn',
          'hasReviewReport', 'reviewReport', 'createdAt'
        ]) &&
        data.shareId is string && data.shareId.size() >= 1 && data.shareId.size() <= 64 && data.shareId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.creatorUid is string && data.creatorUid.size() >= 1 && data.creatorUid.size() <= 128 &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 64 &&
        data.whiteName is string && data.whiteName.size() >= 1 && data.whiteName.size() <= 64 &&
        data.blackName is string && data.blackName.size() >= 1 && data.blackName.size() <= 64 &&
        (!('result' in data) || (data.result is string && data.result.size() <= 16)) &&
        (!('timeControl' in data) || (data.timeControl is string && data.timeControl.size() <= 24)) &&
        (!('openingName' in data) || (data.openingName is string && data.openingName.size() <= 120)) &&
        (!('eco' in data) || (data.eco is string && data.eco.size() <= 12)) &&
        data.pgn is string && data.pgn.size() >= 1 && data.pgn.size() <= 30000 &&
        data.hasReviewReport is bool &&
        (!('reviewReport' in data) || (
          data.reviewReport is map &&
          data.reviewReport.keys().hasAll(['moves', 'whiteAccuracy', 'blackAccuracy', 'whiteCounts', 'blackCounts', 'phases', 'openingName', 'eco']) &&
          data.reviewReport.moves is list && data.reviewReport.moves.size() <= 400 &&
          data.reviewReport.whiteAccuracy is number &&
          data.reviewReport.blackAccuracy is number &&
          data.reviewReport.whiteCounts is map &&
          data.reviewReport.blackCounts is map &&
          data.reviewReport.phases is map &&
          data.reviewReport.openingName is string && data.reviewReport.openingName.size() <= 120 &&
          data.reviewReport.eco is string && data.reviewReport.eco.size() <= 12
        ));
    }

    // Connection Probe
    match /test/connection {
      allow get: if true;
    }

    // Public Player Profiles (No PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.status == 'active');
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'user' || isOwnerEmail()) &&
        incoming().status == 'active' &&
        (incoming().membership == 'free' || isOwnerEmail());
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().membership == existing().membership &&
            incoming().isTestAccount == existing().isTestAccount &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'displayName', 'avatarUrl', 'country', 'bio',
              'boardTheme', 'pieceStyle', 'soundEnabled', 'soundVolume', 'showCoordinates',
              'autoQueen', 'lowTimeWarningColor', 'language', 'ratings', 'rd', 'volatility', 'puzzleStreak',
              'bestPuzzleStreak', 'dailyStreak', 'bestDailyStreak',
              'lastDailyPuzzleDate', 'dailyPuzzlesCompleted', 'puzzlesSolved',
              'playStreakDays', 'bestPlayStreakDays', 'lastPlayDate',
              'gamesPlayed', 'wins', 'losses', 'draws', 'achievements',
              'onlineStatus', 'lastSeenAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin();

      match /private/{docId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && (request.auth.uid == userId || isAdmin());
        allow create: if isVerifiedUser() && isValidId(userId) && isValidId(docId) &&
          (request.auth.uid == userId || isAdmin()) &&
          isValidPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(userId) && isValidId(docId) &&
          (request.auth.uid == userId || isAdmin()) &&
          isValidPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      }
    }

    // Owner / Admin Role Markers
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow create, update: if isOwnerEmail() && isValidId(userId) &&
        incoming().keys().hasAll(['uid', 'email', 'role', 'grantedAt']) &&
        incoming().keys().hasOnly(['uid', 'email', 'role', 'grantedAt']) &&
        incoming().uid == userId &&
        incoming().email == 'eyadbisness@gmail.com' &&
        incoming().role == 'owner' &&
        incoming().grantedAt == request.time;
    }

    // Completed Games & History
    match /games/{gameId} {
      allow get: if isSignedIn() && isValidId(gameId);
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.whiteId == request.auth.uid ||
        resource.data.blackId == request.auth.uid ||
        resource.data.rated == true
      ));
      allow create: if isVerifiedUser() && isValidId(gameId) &&
        isValidChessGame(incoming()) &&
        (incoming().whiteId == request.auth.uid || incoming().blackId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() && isValidId(gameId) &&
        isValidChessGame(incoming()) &&
        incoming().whiteId == existing().whiteId &&
        incoming().blackId == existing().blackId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            (existing().whiteId == request.auth.uid || existing().blackId == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reviewSummary'])
          )
        );
      allow delete: if isAdmin();
    }

    // Friendships & Blocks
    match /friendships/{friendshipId} {
      allow get: if isVerifiedUser() && isValidId(friendshipId) && (request.auth.uid in existing().users || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && request.auth.uid in resource.data.users);
      allow create: if isVerifiedUser() && isValidId(friendshipId) &&
        isValidFriendship(incoming()) &&
        incoming().requesterId == request.auth.uid &&
        incoming().status in ['pending', 'blocked'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(friendshipId) &&
        isValidFriendship(incoming()) &&
        incoming().requesterId == existing().requesterId &&
        incoming().recipientId == existing().recipientId &&
        incoming().users == existing().users &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            request.auth.uid in existing().users &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(friendshipId) && (request.auth.uid in existing().users || isAdmin());
    }

    // Direct Challenges
    match /challenges/{challengeId} {
      allow get: if isVerifiedUser() && isValidId(challengeId) &&
        (existing().challengerId == request.auth.uid || existing().targetId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && (
        resource.data.challengerId == request.auth.uid ||
        resource.data.targetId == request.auth.uid
      ));
      allow create: if isVerifiedUser() && isValidId(challengeId) &&
        isValidChallenge(incoming()) &&
        incoming().challengerId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(challengeId) &&
        isValidChallenge(incoming()) &&
        incoming().challengerId == existing().challengerId &&
        incoming().targetId == existing().targetId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().status == 'pending' &&
            (
              (request.auth.uid == existing().challengerId && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
              (request.auth.uid == existing().targetId && incoming().status in ['accepted', 'declined'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'gameId', 'updatedAt']))
            )
          )
        );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isVerifiedUser() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().read == false &&
        incoming().createdAt == request.time &&
        (isAdmin() || incoming().type in ['friend_request', 'challenge', 'game_result']);
      allow update: if isVerifiedUser() && isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']))
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Reports
    match /reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.reporterId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reporterId == existing().reporterId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolutionNote', 'updatedAt']);
    }

    // Platform Configuration (Owner Write, Signed-In Read)
    match /platformConfig/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow create, update: if isAdmin() && isValidId(docId) &&
        isValidPlatformConfig(incoming()) &&
        incoming().updatedAt == request.time;
    }

    // Owner-Managed Content
    match /customPuzzles/{puzzleId} {
      allow get: if isSignedIn() && isValidId(puzzleId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow create: if isAdmin() && isValidId(puzzleId) && isValidCustomPuzzle(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(puzzleId) && isValidCustomPuzzle(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(puzzleId);
    }

    match /customLessons/{lessonId} {
      allow get: if isSignedIn() && isValidId(lessonId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow create: if isAdmin() && isValidId(lessonId) && isValidCustomLesson(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(lessonId) && isValidCustomLesson(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(lessonId);
    }

    match /tournaments/{tournamentId} {
      allow get: if isSignedIn() && isValidId(tournamentId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.published == true);
      allow create: if isAdmin() && isValidId(tournamentId) && isValidTournament(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(tournamentId) && isValidTournament(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(tournamentId);
    }

    // Owner-Only Audit Logs (Immutable)
    match /ownerAuditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidOwnerAuditLog(incoming()) && incoming().createdAt == request.time;
    }

    // Owner-Only Test Accounts Sandbox
    match /ownerTestAccounts/{testId} {
      allow get: if isAdmin() && isValidId(testId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(testId) && isValidOwnerTestAccount(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(testId) && isValidOwnerTestAccount(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(testId);
    }

    // Publicly Shareable Game Reviews (No PII; single-doc get by unguessable shareId)
    match /sharedGames/{shareId} {
      allow get: if isValidId(shareId);
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.creatorUid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(shareId) &&
        isValidSharedGame(incoming()) &&
        incoming().shareId == shareId &&
        incoming().creatorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(shareId) &&
        isValidSharedGame(incoming()) &&
        incoming().shareId == existing().shareId &&
        incoming().creatorUid == existing().creatorUid &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            existing().creatorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hasReviewReport', 'reviewReport', 'openingName', 'eco',
              'whiteName', 'blackName', 'result', 'timeControl'
            ])
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(shareId) &&
        (existing().creatorUid == request.auth.uid || isAdmin());
    }
  }
}
